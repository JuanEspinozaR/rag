# =============================================================================
# RAG Platform - Environment Variables Example
# Copy this file to .env and fill in the values
# =============================================================================

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=ragplatform
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ragplatform
SPRING_DATASOURCE_USERNAME=raguser
SPRING_DATASOURCE_PASSWORD=ragpassword

# =============================================================================
# pgvector
# =============================================================================
PGVECTOR_DIMENSION=1536

# =============================================================================
# PgAdmin
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@ragplatform.local
PGADMIN_DEFAULT_PASSWORD=admin

# =============================================================================
# Langfuse
# =============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_HOST=http://langfuse-server:3000

# Langfuse database (separate schema in same postgres or separate DB)
LANGFUSE_DATABASE_URL=postgresql://raguser:ragpassword@postgres:5432/langfuse

# Langfuse admin user (bootstrapped on first run)
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=langfusepassword

LANGFUSE_INIT_ORG_ID=org-rag-platform
LANGFUSE_INIT_ORG_NAME=RAG Platform

LANGFUSE_INIT_PROJECT_ID=proj-rag-platform
LANGFUSE_INIT_PROJECT_NAME=RAG Platform
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-your-langfuse-secret-key

LANGFUSE_NEXTAUTH_SECRET=your-langfuse-nextauth-secret-32chars
LANGFUSE_SALT=your-langfuse-salt-32chars

# =============================================================================
# Redis (used by Langfuse worker)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# ClickHouse (used by Langfuse for analytics)
# =============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080

# =============================================================================
# Backend / Spring
# =============================================================================
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
LOG_LEVEL=INFO
